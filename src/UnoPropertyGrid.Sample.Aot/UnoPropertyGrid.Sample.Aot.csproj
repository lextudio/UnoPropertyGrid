<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-arm64;osx-x64</RuntimeIdentifiers>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>UnoPropertyGrid AOT Sample</ApplicationTitle>
    <ApplicationId>com.lextudio.unopropertygrid.sample.aot</ApplicationId>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Write generator output to obj/.../generated/ so the emitted code is visible for review. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <UseNuGetPackages>false</UseNuGetPackages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);WINDOWS_APP_SDK</DefineConstants>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuGetPackages)' != 'true'">
    <ProjectReference Include="..\UnoPropertyGrid\UnoPropertyGrid.csproj" />
    <!--
      Reference the generator so the Roslyn analyser runs during this project's build.
      OutputItemType + ReferenceOutputAssembly keep the generator DLL out of the
      runtime output while still feeding it to the compiler as an analyser.
    -->
    <ProjectReference Include="..\UnoPropertyGrid.Generator\UnoPropertyGrid.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetPackages)' == 'true'">
    <PackageReference Include="LeXtudio.UnoPropertyGrid" />
    <!--
      The generator NuGet package ships the analyser DLL under analyzers/dotnet/cs/,
      which NuGet wires up automatically — no OutputItemType needed.
    -->
    <PackageReference Include="LeXtudio.UnoPropertyGrid.Generator" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" Condition="'$(TargetFramework)' == 'net10.0-desktop'" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Platforms\\**" />
  </ItemGroup>
</Project>
