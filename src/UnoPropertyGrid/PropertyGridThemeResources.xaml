<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Theme-aware brushes only. Every key is defined in the ThemeDictionaries below (Light / Dark /
      Default) and consumed via {ThemeResource}. There must be NO theme-agnostic copies at the
      dictionary's top level: a top-level key shadows the matching ThemeDictionaries entry, so the
      control rendered with those fixed (dark) colors regardless of theme — the bug where the
      PropertyGrid showed dark controls under the Light theme. Removing them also stops generic keys
      (TextControlBackground, ComboBoxBackground, …) leaking app-wide when this dictionary is merged
      into Application.Resources.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonForeground" Color="#1E1E1E" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />
