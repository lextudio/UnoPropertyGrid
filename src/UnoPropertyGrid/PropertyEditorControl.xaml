<UserControl
    x:Class="UnoPropertyGrid.PropertyEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="PropertyGridThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PropertyGridForegroundBrush}" />
                <Setter Property="Background" Value="{ThemeResource PropertyGridCellBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PropertyGridBorderBrush}" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PropertyGridForegroundBrush}" />
                <Setter Property="Background" Value="{ThemeResource PropertyGridCellBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PropertyGridBorderBrush}" />
            </Style>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PropertyGridForegroundBrush}" />
                <Setter Property="Background" Value="{ThemeResource PropertyGridCellBrush}" />
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Foreground" Value="{ThemeResource PropertyGridForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PropertyGridMutedForegroundBrush}" />
                <Setter Property="Background" Value="{ThemeResource PropertyGridCellBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <CheckBox x:Name="BooleanEditor"
              IsChecked="{x:Bind BooleanValue, Mode=TwoWay}"
              Visibility="{x:Bind BooleanEditorVisibility, Mode=OneWay}" />

        <CheckBox x:Name="ReadOnlyBooleanEditor"
              IsChecked="{x:Bind BooleanValue, Mode=OneWay}"
              IsEnabled="False"
              Visibility="{x:Bind ReadOnlyBooleanEditorVisibility, Mode=OneWay}" />

        <TextBox x:Name="TextEditor"
                 Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{x:Bind TextEditorVisibility, Mode=OneWay}" />

        <TextBox x:Name="NumberEditor"
                 Text="{x:Bind NumberValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 InputScope="Number"
                 Visibility="{x:Bind NumberEditorVisibility, Mode=OneWay}" />

        <ComboBox x:Name="EnumEditor"
                  ItemsSource="{x:Bind EnumValues, Mode=OneWay}"
                  SelectedItem="{x:Bind EnumValue, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind EnumEditorVisibility, Mode=OneWay}" />

        <Grid Visibility="{x:Bind BrushEditorVisibility, Mode=OneWay}" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="18"
                    Height="18"
                    BorderBrush="{ThemeResource TextControlBorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Rectangle Fill="{x:Bind BrushPreview, Mode=OneWay}" />
            </Border>
            <ComboBox x:Name="BrushEditor"
                      Grid.Column="1"
                      ItemsSource="{x:Bind CommonBrushes, Mode=OneWay}"
                      SelectedItem="{x:Bind BrushValue, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
        </Grid>

        <ComboBox x:Name="FontFamilyEditor"
                  ItemsSource="{x:Bind FontFamilies, Mode=OneWay}"
                  SelectedItem="{x:Bind FontFamilyValue, Mode=TwoWay}"
                  FontFamily="{x:Bind FontFamilyValue, Mode=OneWay}"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind FontFamilyEditorVisibility, Mode=OneWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        FontFamily="{Binding}"
                        Foreground="{ThemeResource PropertyGridForegroundBrush}"
                        TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox x:Name="FontWeightEditor"
                  ItemsSource="{x:Bind FontWeights, Mode=OneWay}"
                  SelectedItem="{x:Bind FontWeightValue, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind FontWeightEditorVisibility, Mode=OneWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        FontWeight="{Binding}"
                        Foreground="{ThemeResource PropertyGridForegroundBrush}"
                        TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox x:Name="FontStyleEditor"
                  ItemsSource="{x:Bind FontStyles, Mode=OneWay}"
                  SelectedItem="{x:Bind FontStyleValue, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind FontStyleEditorVisibility, Mode=OneWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        FontStyle="{Binding}"
                        Foreground="{ThemeResource PropertyGridForegroundBrush}"
                        TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ComboBox x:Name="FontStretchEditor"
                  ItemsSource="{x:Bind FontStretches, Mode=OneWay}"
                  SelectedItem="{x:Bind FontStretchValue, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  Visibility="{x:Bind FontStretchEditorVisibility, Mode=OneWay}" />

        <TextBlock x:Name="ReadOnlyEditor"
                   Text="{x:Bind ReadOnlyValue, Mode=OneWay}"
                   Opacity="0.9"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource PropertyGridForegroundBrush}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{x:Bind ReadOnlyEditorVisibility, Mode=OneWay}" />
    </Grid>
</UserControl>
