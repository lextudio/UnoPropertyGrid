<UserControl
    x:Class="UnoPropertyGrid.PropertyGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnoPropertyGrid"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PropertyGridThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="PropertyTemplate">
                <Border
                    BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{ThemeResource PropertyGridCellBrush}">
                    <Grid
                        MinHeight="24"
                        Background="{ThemeResource PropertyGridCellBrush}"
                        ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ElementName=RootControl, Path=NameColumnWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="20,2,4,2"
                            BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                            BorderThickness="0">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding DisplayName}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            Padding="4,1"
                            BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                            BorderThickness="0">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                                Text="{Binding DisplayValue}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="3,0"
                            BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Default or overridden value indicator">
                            <Rectangle
                                Width="6"
                                Height="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="Transparent"
                                Stroke="{ThemeResource PropertyGridMutedForegroundBrush}"
                                StrokeThickness="1" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CategoryTemplate">
                <StackPanel Background="{ThemeResource PropertyGridBackgroundBrush}">
                    <ToggleButton
                        MinHeight="24"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource PropertyGridCategoryBrush}"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                                Glyph="{Binding ExpandGlyph}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                                Text="{Binding Name}" />
                        </Grid>
                    </ToggleButton>
                    <ItemsControl
                        ItemTemplate="{StaticResource PropertyTemplate}"
                        ItemsSource="{Binding Rows}"
                        Visibility="{Binding RowsVisibility}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="EventTemplate">
                <Grid
                    MinHeight="24"
                    Background="{ThemeResource PropertyGridBackgroundBrush}"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=RootControl, Path=NameColumnWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20,2,4,2"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource PropertyGridForegroundBrush}"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBox
                        Grid.Column="1"
                        MinHeight="24"
                        Padding="4,2"
                        FontSize="12"
                        Text="{Binding HandlerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border
                        Grid.Column="2"
                        Padding="3,0"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1"
                        ToolTipService.ToolTip="Default or overridden value indicator">
                        <Rectangle
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="Transparent"
                            Stroke="{ThemeResource PropertyGridMutedForegroundBrush}"
                            StrokeThickness="1" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootControl"
        Background="{ThemeResource PropertyGridBackgroundBrush}"
        RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderPanel"
            Padding="8,6,8,4"
            Background="{ThemeResource PropertyGridPanelBrush}"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon
                x:Name="ObjectGlyph"
                Grid.RowSpan="2"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{ThemeResource PropertyGridMutedForegroundBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                x:Name="NameLabel"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="Name" />
            <TextBox
                x:Name="ObjectNameBox"
                Grid.Column="2"
                MinHeight="22"
                Padding="4,2"
                Background="{ThemeResource PropertyGridCellBrush}"
                BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                IsReadOnly="True"
                Text="{x:Bind ObjectName, Mode=OneWay}" />

            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="2">
                <ToggleButton
                    x:Name="PropertiesButton"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Checked="OnViewModeChecked"
                    IsChecked="True"
                    ToolTipService.ToolTip="Properties">
                    <FontIcon FontSize="13" Glyph="&#xE90F;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="EventsButton"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Checked="OnViewModeChecked"
                    ToolTipService.ToolTip="Events">
                    <FontIcon FontSize="13" Glyph="&#xE945;" />
                </ToggleButton>
            </StackPanel>

            <TextBlock
                x:Name="TypeLabel"
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="Type" />
            <TextBlock
                x:Name="ObjectTypeTextBlock"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="{x:Bind ObjectTypeName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Margin="8,4,8,3" Background="{ThemeResource PropertyGridPanelBrush}">
            <TextBox
                x:Name="SearchBox"
                MinHeight="24"
                Padding="4,2,28,2"
                Background="{ThemeResource PropertyGridCellBrush}"
                BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                PlaceholderText="Search"
                TextChanged="OnSearchTextChanged" />
            <FontIcon
                x:Name="SearchGlyph"
                Margin="0,0,7,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource PropertyGridMutedForegroundBrush}"
                Glyph="&#xE721;" />
        </Grid>

        <StackPanel
            x:Name="ArrangeByPanel"
            Grid.Row="2"
            Padding="8,0,8,4"
            Background="{ThemeResource PropertyGridPanelBrush}"
            Orientation="Horizontal"
            Spacing="2">
            <TextBlock
                x:Name="ArrangeByLabel"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="Arrange by:" />
            <ComboBox
                x:Name="ArrangeByComboBox"
                MinWidth="86"
                Padding="2,0"
                Background="{ThemeResource PropertyGridCellBrush}"
                BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                SelectedIndex="0"
                SelectionChanged="OnArrangeByChanged">
                <ComboBoxItem
                    Background="{ThemeResource PropertyGridCellBrush}"
                    Content="Category"
                    Foreground="{ThemeResource PropertyGridForegroundBrush}" />
                <ComboBoxItem
                    Background="{ThemeResource PropertyGridCellBrush}"
                    Content="Name"
                    Foreground="{ThemeResource PropertyGridForegroundBrush}" />
            </ComboBox>
        </StackPanel>

        <Grid
            x:Name="RowsHost"
            Grid.Row="3"
            SizeChanged="OnRowsHostSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RowsHostNameColumn" Width="220" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RowsHostValueColumn" Width="*" MinWidth="140" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.ColumnSpan="3"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="CategorizedRowsPanel" />
                    <StackPanel x:Name="FlatRowsPanel" Visibility="Collapsed" />
                    <StackPanel x:Name="EventRowsPanel" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>

            <toolkit:GridSplitter
                x:Name="NameColumnSplitter"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeDirection="Columns" />
        </Grid>

        <Border
            x:Name="DescriptionPane"
            Grid.Row="4"
            Padding="6,4"
            Background="{ThemeResource PropertyGridPanelBrush}"
            BorderBrush="{ThemeResource PropertyGridBorderBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    x:Name="DescriptionTitle"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PropertyGridForegroundBrush}" />
                <TextBlock
                    x:Name="DescriptionText"
                    FontSize="12"
                    Foreground="{ThemeResource PropertyGridMutedForegroundBrush}"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
