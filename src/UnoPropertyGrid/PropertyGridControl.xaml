<UserControl
    x:Class="UnoPropertyGrid.PropertyGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnoPropertyGrid">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PropertyGridPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PropertyGridCellBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PropertyGridCategoryBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="PropertyGridMutedForegroundBrush" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="#007ACC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="PropertyGridPanelBrush" Color="#252526" />
                    <SolidColorBrush x:Key="PropertyGridCellBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="PropertyGridCategoryBrush" Color="#252526" />
                    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="PropertyGridMutedForegroundBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="#007ACC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="PropertyGridPanelBrush" Color="#252526" />
                    <SolidColorBrush x:Key="PropertyGridCellBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="PropertyGridCategoryBrush" Color="#252526" />
                    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="PropertyGridMutedForegroundBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="#007ACC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <DataTemplate x:Key="PropertyTemplate">
                <Grid
                    MinHeight="24"
                    Background="{ThemeResource PropertyGridBackgroundBrush}"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=RootControl, Path=NameColumnWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20,2,4,2"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource PropertyGridForegroundBrush}"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="4,1"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <local:PropertyEditorControl ViewModel="{Binding}" />
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="3,0"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1"
                        ToolTipService.ToolTip="Default or overridden value indicator">
                        <Rectangle
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="Transparent"
                            Stroke="{ThemeResource PropertyGridMutedForegroundBrush}"
                            StrokeThickness="1" />
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CategoryTemplate">
                <StackPanel Background="{ThemeResource PropertyGridBackgroundBrush}">
                    <ToggleButton
                        MinHeight="24"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource PropertyGridCategoryBrush}"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                                Glyph="{Binding ExpandGlyph}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                                Text="{Binding Name}" />
                        </Grid>
                    </ToggleButton>
                    <ItemsControl
                        ItemTemplate="{StaticResource PropertyTemplate}"
                        ItemsSource="{Binding Rows}"
                        Visibility="{Binding RowsVisibility}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="EventTemplate">
                <Grid
                    MinHeight="24"
                    Background="{ThemeResource PropertyGridBackgroundBrush}"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=RootControl, Path=NameColumnWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="20,2,4,2"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource PropertyGridForegroundBrush}"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBox
                        Grid.Column="1"
                        MinHeight="24"
                        Padding="4,2"
                        FontSize="12"
                        Text="{Binding HandlerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border
                        Grid.Column="2"
                        Padding="3,0"
                        BorderBrush="{ThemeResource PropertyGridBorderBrush}"
                        BorderThickness="0,0,0,1"
                        ToolTipService.ToolTip="Default or overridden value indicator">
                        <Rectangle
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="Transparent"
                            Stroke="{ThemeResource PropertyGridMutedForegroundBrush}"
                            StrokeThickness="1" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootControl"
        Background="{ThemeResource PropertyGridBackgroundBrush}"
        RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderPanel"
            Padding="8,6,8,4"
            Background="{ThemeResource PropertyGridPanelBrush}"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon
                x:Name="ObjectGlyph"
                Grid.RowSpan="2"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{ThemeResource PropertyGridMutedForegroundBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                x:Name="NameLabel"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="Name" />
            <TextBox
                x:Name="ObjectNameBox"
                Grid.Column="2"
                MinHeight="22"
                Padding="4,2"
                FontSize="12"
                IsReadOnly="True"
                Text="{x:Bind ObjectName, Mode=OneWay}" />

            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="2">
                <ToggleButton
                    x:Name="PropertiesButton"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Checked="OnViewModeChecked"
                    IsChecked="True"
                    ToolTipService.ToolTip="Properties">
                    <FontIcon FontSize="13" Glyph="&#xE713;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="EventsButton"
                    Width="24"
                    Height="22"
                    Padding="0"
                    Checked="OnViewModeChecked"
                    ToolTipService.ToolTip="Events">
                    <FontIcon FontSize="13" Glyph="&#xE945;" />
                </ToggleButton>
            </StackPanel>

            <TextBlock
                x:Name="TypeLabel"
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="Type" />
            <TextBlock
                x:Name="ObjectTypeTextBlock"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="{x:Bind ObjectTypeName, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Margin="8,4,8,3">
            <TextBox
                x:Name="SearchBox"
                MinHeight="24"
                Padding="4,2,28,2"
                FontSize="12"
                PlaceholderText="Search"
                TextChanged="OnSearchTextChanged" />
            <FontIcon
                x:Name="SearchGlyph"
                Margin="0,0,7,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource PropertyGridMutedForegroundBrush}"
                Glyph="&#xE721;" />
        </Grid>

        <StackPanel
            x:Name="ArrangeByPanel"
            Grid.Row="2"
            Padding="8,0,8,4"
            Background="{ThemeResource PropertyGridBackgroundBrush}"
            Orientation="Horizontal"
            Spacing="2">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource PropertyGridForegroundBrush}"
                Text="Arrange by:" />
            <ComboBox
                x:Name="ArrangeByComboBox"
                MinWidth="86"
                Padding="2,0"
                FontSize="12"
                SelectedIndex="0"
                SelectionChanged="OnArrangeByChanged">
                <ComboBoxItem Content="Category" />
                <ComboBoxItem Content="Name" />
            </ComboBox>
        </StackPanel>

        <ScrollViewer
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="CategorizedRowsPanel" />
                <StackPanel x:Name="FlatRowsPanel" Visibility="Collapsed" />
                <StackPanel x:Name="EventRowsPanel" Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="DescriptionPane"
            Grid.Row="4"
            Padding="6,4"
            Background="{ThemeResource PropertyGridPanelBrush}"
            BorderBrush="{ThemeResource PropertyGridBorderBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    x:Name="DescriptionTitle"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource PropertyGridForegroundBrush}" />
                <TextBlock
                    x:Name="DescriptionText"
                    FontSize="12"
                    Foreground="{ThemeResource PropertyGridMutedForegroundBrush}"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
